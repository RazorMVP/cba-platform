<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <!--
    OWASP Dependency-Check Suppressions — CBA Backend
    Reviewed 2026-04-24 by RazorMVP

    Identifier strategy used in this file:
    - <gav regex="true"> — confirmed working for artifacts with GAV-only identifiers
      (Quartz, Keycloak admin client, mchange-commons). DC does NOT expose a GAV
      identifier for artifacts matched via CPE (Netty, Spring, Tomcat); use
      <fileName regex="true"> for those.
    - <fileName regex="true"> — matches the on-disk filename of the JAR. Also matches
      embedded-POM Dependency objects whose filename is
      "parent-jar.jar/META-INF/maven/…/pom.xml". Bypasses all PURL and CPE
      identifier format ambiguity.
    - Suppression schema: 1.3 (https://jeremylong.github.io/DependencyCheck/…)
  -->

  <!-- ══════════════════════════════════════════════════════════════════
       Quartz Scheduler 2.3.2 — CVE-2023-39017 (CVSS 9.8)
       Not applicable: no fixed 2.x release exists; Spring Boot wraps Quartz
       with LocalDataSourceJobStore (prepared statements); all job parameters
       are internal server-side data. Reviewed 2026-04-14.
       ══════════════════════════════════════════════════════════════════ -->
  <suppress>
    <notes><![CDATA[CVE-2023-39017 — Quartz 2.3.2 SQL injection in JobStoreSupport.
      Not applicable: no fixed 2.x version exists; Spring Boot wraps with
      LocalDataSourceJobStore; all job parameters are internal.]]></notes>
    <gav regex="true">^org\.quartz-scheduler:quartz:.*$</gav>
    <cve>CVE-2023-39017</cve>
  </suppress>

  <!-- ══════════════════════════════════════════════════════════════════
       mchange-commons-java 0.2.15 — CVE-2026-27727 (CVSS 8.9)
       Optional transitive dep of Quartz. CBA uses HikariCP; c3p0 is never
