<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <!--
    OWASP Dependency-Check Suppressions
    Add false positive suppressions here with justification.
    Format: <suppress> ... <cve>CVE-XXXX-XXXXX</cve> ... </suppress>

    IMPORTANT: Every suppression MUST include:
    1. The CVE being suppressed
    2. The reason (false positive / not applicable)
    3. The date it was reviewed
    4. The reviewer's name

    Example:
    <suppress>
      <notes>
        CVE-2023-12345 — False positive. This CVE affects the foo-bar artifact only
        when used with the xyz configuration we do not use. Reviewed 2024-01-15 by Alice.
      </notes>
      <gav regex="true">^org\.example:foo-bar:.*$</gav>
      <cve>CVE-2023-12345</cve>
    </suppress>
  -->
</suppressions>
