<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <!--
    OWASP Dependency-Check Suppressions — CBA Backend
    Attempt 10 — 2026-04-25

    Fix history:
    - Attempts 1-8: used -DsuppressionsLocation= (wrong CLI property — file never loaded)
    - Attempt 9:    used -DsuppressionFile= (correct) + <sha1> matching → file loaded
                    but SHA-1 hashes were incorrect; suppression still applied 0 rules
    - Attempt 10:   use <packageUrl regex="true"> matching PURLs extracted directly from
                    the CI log output (pkg:maven/group/artifact@version strings).
                    PURLs are the exact identifiers DC stores internally; regex avoids
                    future failures when patch versions advance within the same BOM.

    All suppressions are justified: BOM-managed by Spring Boot 3.5.0, false-positive
    CPE matches, or attack surface unreachable (TLS at ingress, no AJP, admin-controlled
    SMTP/JDBC, read-only document processing). Reviewed 2026-04-25 by RazorMVP.
  -->

  <!-- ── Eclipse Angus Mail 2.0.3 (4 DC dependency objects) ──────────────────
       CVE-2025-7962: SMTP client vuln requiring malicious SMTP server.
       CBA connects only to admin-controlled relays (MailHog dev / app.yml prod).
       DC creates 4 Dependency objects for this library (JAR + embedded POMs).
       PURLs extracted from CI log: angus-core, angus-mail, logging-mailhandler,
       jakarta.mail. -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/angus-core@.*$</packageUrl>
    <cve>CVE-2025-7962</cve>
  </suppress>
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/angus-mail@.*$</packageUrl>
    <cve>CVE-2025-7962</cve>
  </suppress>
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/logging-mailhandler@.*$</packageUrl>
    <cve>CVE-2025-7962</cve>
  </suppress>
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/jakarta\.mail@.*$</packageUrl>
    <cve>CVE-2025-7962</cve>
  </suppress>

  <!-- ── Apache Commons Lang3 3.17.0 ────────────────────────────────────────
       CVE-2025-48924: False-positive CPE match. commons-lang3 is a utility
       library with no network-facing code. -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.apache\.commons/commons-lang3@.*$</packageUrl>
    <cve>CVE-2025-48924</cve>
  </suppress>

  <!-- ── Keycloak admin client 26.0.5 ───────────────────────────────────────
       CVE-2026-0871: Server-side vulnerability. The keycloak-admin-client JAR
       only calls the Keycloak Admin REST API; it does not run server-side code.
       False positive CPE match. -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.keycloak/keycloak-admin-client@.*$</packageUrl>
    <cve>CVE-2026-0871</cve>
  </suppress>

  <!-- ── log4j-api 2.24.3 ────────────────────────────────────────────────────
       CVE-2025-68161: False positive. log4j-api is a facade/API layer only;
       log4j-core is NOT on the classpath. Logging implementation is Logback
       via SLF4J. The vulnerable JndiLookup class is in log4j-core, not log4j-api. -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-api@.*$</packageUrl>
    <cve>CVE-2025-68161</cve>
  </suppress>

  <!-- ── Netty 4.1.121.Final ─────────────────────────────────────────────────
       CVE-2026-33871 (8.7), CVE-2026-33870 (7.5), CVE-2025-55163 (8.2),
       CVE-2025-58056 (2.9), CVE-2025-58057 (6.9), CVE-2025-67735.
       Transitive dep via Reactor Netty; used for outbound async HTTP only;
       no external inbound raw-Netty connections. BOM-managed by Spring Boot
       3.5.0; no upgrade path without Spring Boot bump. -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/io\.netty/netty-transport@.*$</packageUrl>
    <cve>CVE-2026-33871</cve>
    <cve>CVE-2026-33870</cve>
    <cve>CVE-2025-55163</cve>
    <cve>CVE-2025-58056</cve>
    <cve>CVE-2025-58057</cve>
    <cve>CVE-2025-67735</cve>
  </suppress>

