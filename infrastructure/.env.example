# ============================================================
# CBA Platform — Environment Variables
#
# Copy this file to .env and fill in all values before running.
# The .env file is gitignored — NEVER commit it.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with real values
#   docker-compose up                    # infrastructure only
#   docker-compose --profile app up      # full stack
# ============================================================

# ─── GitHub Container Registry ──────────────────────────────
# Your GitHub org/username (used to pull app images from GHCR)
GITHUB_ORG=razormvp

# Image tag to run (use a commit SHA for pinned deployments)
VERSION=latest

# ─── PostgreSQL — Main (monolith + Keycloak) ────────────────
# Password for the cba_user database account
POSTGRES_MAIN_PASSWORD=<CHANGE_ME>

# Password for the keycloak_user database account
KEYCLOAK_DB_PASSWORD=<CHANGE_ME>

# ─── PostgreSQL — Card Service ───────────────────────────────
# Password for the card_user database account
POSTGRES_CARD_PASSWORD=<CHANGE_ME>

# ─── Keycloak ────────────────────────────────────────────────
# Keycloak admin console credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<CHANGE_ME>

# ─── Encryption ──────────────────────────────────────────────
# AES-256 master key for Jasypt field-level encryption of PII.
# Must be at least 32 characters. Generate with:
#   openssl rand -base64 48 | tr -d '\n'
# WARNING: Changing this after data is written requires re-encrypting
# all PII fields in the database. Treat this like a private key.
ENCRYPTION_KEY=<CHANGE_ME_MIN_32_CHARS>

# ─── Card Service HSM ────────────────────────────────────────
# HSM provider: SOFTWARE (dev) | THALES (production)
FEP_HSM_PROVIDER=SOFTWARE

# Thales payShield connection (only needed when FEP_HSM_PROVIDER=THALES)
# THALES_HSM_HOST=hsm.internal.example.com
# THALES_HSM_PORT=1500

# ─── Application URLs (used by --profile app services) ───────
# These are the internal Docker network addresses — do not change
# unless you rename the service containers in docker-compose.yml
BACKEND_URL=http://backend:8080
CARD_SERVICE_URL=http://card-service:8081
KEYCLOAK_URL=http://keycloak:8180
