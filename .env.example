# ──────────────────────────────────────────────────────────────────────────────
# CBA Platform — Environment Variables Reference
# Copy to .env.local (never commit .env.local or .env with real values)
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=cba_pass
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cba_db
DB_USER=cba_user

# ── Backend Encryption ────────────────────────────────────────────────────────
# Must be exactly 32 characters for AES-256
ENCRYPTION_KEY=changeme-32-char-secret-key!!!!

# ── Keycloak ──────────────────────────────────────────────────────────────────
KC_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=cba
KEYCLOAK_CLIENT_ID_WEB=cba-web
KEYCLOAK_CLIENT_ID_MOBILE=cba-mobile

# ── Angular (web/.env) ────────────────────────────────────────────────────────
NG_APP_API_URL=http://localhost:8080
NG_APP_KEYCLOAK_URL=http://localhost:8180
NG_APP_KEYCLOAK_REALM=cba
NG_APP_KEYCLOAK_CLIENT_ID=cba-web

# ── Flutter (dart-define at build time) ───────────────────────────────────────
# flutter run --dart-define=API_BASE_URL=http://localhost:8080 ...
API_BASE_URL=http://localhost:8080
KEYCLOAK_ISSUER=http://localhost:8180/realms/cba

# ── Vercel (web Vercel project) ───────────────────────────────────────────────
VERCEL_TOKEN=           # Personal Access Token from vercel.com/account/tokens
VERCEL_ORG_ID=          # From web/.vercel/project.json after vercel link --repo
VERCEL_PROJECT_ID_WEB=  # From web/.vercel/project.json

# ── GitHub Actions Secrets (set in repo Settings → Secrets) ──────────────────
# VERCEL_TOKEN          — same as above
# SONAR_TOKEN           — from sonarcloud.io
# SNYK_TOKEN            — from app.snyk.io
# NVD_API_KEY           — from nvd.nist.gov/developers/request-an-api-key
# KUBE_CONFIG_STAGING   — base64-encoded kubeconfig for staging cluster
# KUBE_CONFIG_PROD      — base64-encoded kubeconfig for production cluster
# GITLEAKS_LICENSE      — optional, for Gitleaks commercial features

# ── GitHub Actions Variables (set in repo Settings → Variables) ───────────────
# SONAR_ORG             — your SonarCloud organization slug
# API_BASE_URL_STAGING  — https://api-staging.cba.com
# KEYCLOAK_URL_STAGING  — https://auth-staging.cba.com
# API_STAGING_URL       — used by OWASP ZAP scan
