  <!-- ══════════════════════════════════════════════════════════════════
       Tomcat 10.1.41 (Embedded) — 20 CVEs (CVSS 7.5–9.6)
       ══════════════════════════════════════════════════════════════════
       HTTP/2: TLS terminated at K8s ingress; Tomcat not internet-exposed;
         HTTP/2 not enabled in embedded config.
       AJP: AJP connector not configured.
       CLIENT_CERT / OCSP: mTLS not used; all auth via Keycloak OIDC Bearer JWT.
       Session / request CVEs: API gateway shields direct socket access.
       BOM-managed by Spring Boot 3.5.0. No Tomcat override without Spring Boot bump.
       Reviewed 2026-04-24 by RazorMVP.
  -->
  <suppress>
    <notes><![CDATA[tomcat-embed-core 10.1.41 — 20 CVEs (CVSS 7.5–9.6).
      TLS at ingress; not internet-exposed; HTTP/2 off; AJP off; no mTLS.
      BOM-managed; no Tomcat upgrade without Spring Boot upgrade.
      CVE-2025-55754(9.6), CVE-2025-66614(9.1), CVE-2026-29145(9.1),
      CVE-2026-29146(7.5), CVE-2026-34483(7.5), CVE-2026-34487(7.5),
      CVE-2025-48988(7.5), CVE-2025-48989(7.5), CVE-2025-49124(8.4),
