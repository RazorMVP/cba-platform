  <!-- ══════════════════════════════════════════════════════════════════
       Eclipse Angus Mail 2.0.3 — CVE-2025-7962
       ══════════════════════════════════════════════════════════════════
       angus-mail is Spring Boot's JavaMail implementation. CVE-2025-7962
       is an SMTP client vulnerability requiring a malicious SMTP server.
       CBA only connects to admin-controlled relays (MailHog dev; application.yml
       SMTP host in prod). DC creates four Dependency objects for this library:
         (A) angus-mail-2.0.3.jar (standalone JAR)
         (B) angus-mail-2.0.3.jar/.../angus-core/pom.xml (embedded POM)
         (C) jakarta.mail-2.0.3.jar (standalone JAR)
         (D) jakarta.mail-2.0.3.jar/.../logging-mailhandler/pom.xml (embedded POM)
         (E) angus-activation (FALSE POSITIVE — DC issue #8144; unrelated library)
       All five representations suppressed below using <fileName regex>.
       Reviewed 2026-04-24 by RazorMVP.
  -->
  <!-- (A) + (B): angus-mail.jar and its embedded POM dependencies -->
  <suppress>
    <notes><![CDATA[CVE-2025-7962 — angus-mail-2.0.3.jar and embedded POMs.
      SMTP client vuln; app connects only to admin-controlled SMTP relay.
      fileName matches both the JAR and embedded POM paths.]]></notes>
    <fileName regex="true">.*angus-mail-.*</fileName>
    <cve>CVE-2025-7962</cve>
  </suppress>
  <!-- (C) + (D): jakarta.mail.jar and its embedded POM dependencies -->
  <suppress>
    <notes><![CDATA[CVE-2025-7962 — jakarta.mail-2.0.3.jar and embedded POMs.
      Same reasoning: admin-controlled SMTP relay only.]]></notes>
    <fileName regex="true">.*jakarta[.-]mail-.*</fileName>
    <cve>CVE-2025-7962</cve>
  </suppress>
  <!-- (E): angus-activation — DC issue #8144 confirmed false positive -->
  <suppress>
    <notes><![CDATA[CVE-2025-7962 — angus-activation FALSE POSITIVE (DC issue #8144).
      angus-activation is the Jakarta Activation MIME-type library; it has no
      SMTP code. DC incorrectly maps CVE via CPE mismatch.]]></notes>
    <fileName regex="true">.*angus-activation-.*</fileName>
    <cve>CVE-2025-7962</cve>
  </suppress>

  <!-- ══════════════════════════════════════════════════════════════════
       Netty 4.1.121.Final — CVE-2026-33871, CVE-2026-33870, CVE-2025-55163,
       CVE-2025-58056, CVE-2025-58057, CVE-2025-67735
       ══════════════════════════════════════════════════════════════════
       Netty is a transitive dependency via Reactor Netty (async HTTP client).
       These CVEs target Netty HTTP/2 and codec components. No external inbound
       connections use raw Netty in the backend monolith; Netty is used only
       for outbound async calls (to card-service). Spring Boot 3.5.0 ships
       Netty 4.1.121.Final; no upgrade available without a Spring Boot BOM bump.
       Reviewed 2026-04-24 by RazorMVP.
  -->
  <suppress>
    <notes><![CDATA[Netty 4.1.121.Final CVEs. Transitive dep via Reactor Netty;
      used for outbound async HTTP only; no external inbound raw-Netty connections.
      BOM-managed by Spring Boot 3.5.0; no upgrade path without Spring Boot bump.
      CVE-2026-33871(8.7), CVE-2026-33870(7.5), CVE-2025-55163(8.2),
      CVE-2025-58056(2.9), CVE-2025-58057(6.9), CVE-2025-67735.]]></notes>
    <fileName regex="true">netty-transport-.*\.jar</fileName>
    <cve>CVE-2026-33871</cve>
    <cve>CVE-2026-33870</cve>
    <cve>CVE-2025-55163</cve>
    <cve>CVE-2025-58056</cve>
    <cve>CVE-2025-58057</cve>
    <cve>CVE-2025-67735</cve>
  </suppress>

