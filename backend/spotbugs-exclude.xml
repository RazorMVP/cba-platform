<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- DTOs and records have intentional field access patterns -->
    <Match>
        <Class name="~com\.cba\..*\.dto\..*"/>
        <Bug category="STYLE"/>
    </Match>

    <!-- Lombok-generated code -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~com\.cba\..*"/>
    </Match>

    <!-- Spring @Autowired on AttributeConverter is by design -->
    <Match>
        <Class name="com.cba.common.crypto.EncryptedStringConverter"/>
        <Bug pattern="UWF_UNWRITTEN_FIELD"/>
    </Match>

    <!--
        SecurityConfig.devAuthBypassFilter is injected by Spring via @Autowired(required=false).
        It is null in production (the bean doesn't exist without app.auth-bypass=true).
        SpotBugs sees the field as potentially unwritten because it cannot model Spring DI.
    -->
    <Match>
        <Class name="com.cba.config.SecurityConfig"/>
        <Bug pattern="UWF_UNWRITTEN_FIELD"/>
    </Match>

    <!--
        DevAuthBypassFilter.DEV_AUTHORITIES is a private static final List.of() — immutable.
        SpotBugs may flag MS_EXPOSE_REP on static collections even when they are
        unmodifiable. This is dev-only code (ConditionalOnProperty guards it).
    -->
    <Match>
        <Class name="com.cba.config.DevAuthBypassFilter"/>
        <Bug pattern="MS_EXPOSE_REP,MS_SHOULD_BE_FINAL"/>
    </Match>

    <!--
        AuditLogService.toJson() uses string concatenation to build a JSON-escaped fallback.
        SpotBugs may warn about string building patterns; this is intentional defensive code
        for the rare case where Jackson cannot serialize an audit value.
    -->
    <Match>
        <Class name="com.cba.audit.AuditLogService"/>
        <Method name="toJson"/>
        <Bug pattern="DM_STRING_CTOR,SBSC_USE_STRINGBUFFER_CONCATENATION"/>
    </Match>

    <!--
        RateLimitService and RateLimitFilter catch Exception intentionally (fail-open pattern).
        When Redis is unavailable the system must not block legitimate traffic — catching the
        broad Exception from Redis is correct here and the behaviour is documented in comments.
    -->
    <Match>
        <Class name="com.cba.config.RateLimitService"/>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>
    <Match>
        <Class name="com.cba.config.RateLimitFilter"/>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>

    <!--
        ClientImageService deletes the old storage file before replacing it.
        The catch-Exception-ignored pattern on delete is intentional: a failed delete
        of an old file must not abort the save of the new file.
    -->
    <Match>
        <Class name="com.cba.customer.ClientImageService"/>
        <Bug pattern="DE_MIGHT_IGNORE,REC_CATCH_EXCEPTION"/>
    </Match>

    <!--
        NubanSequence has an @EmbeddedId composite key — the class is not directly
        serialised and does not need serialVersionUID.
    -->
    <Match>
        <Class name="com.cba.account.algorithm.NubanSequence"/>
        <Bug pattern="SE_NO_SERIALVERSIONUID,SE_NO_SERIALVERSIONID"/>
    </Match>
    <Match>
        <Class name="com.cba.account.algorithm.NubanSequenceId"/>
        <Bug pattern="SE_NO_SERIALVERSIONUID,SE_NO_SERIALVERSIONID"/>
    </Match>

    <!--
        DM_CONVERT_CASE: toLowerCase()/toUpperCase() without explicit Locale.
        All string comparisons in this codebase use ASCII identifiers (enum names,
        currency codes, status strings) — the default locale is irrelevant here.
        Locale.ROOT variants would add noise without correctness benefit.
    -->
    <Match>
        <Bug pattern="DM_CONVERT_CASE"/>
        <Class name="~com\.cba\..*"/>
    </Match>

    <!--
        SE_NO_SERIALVERSIONUID / SE_NO_SERIALVERSIONID: JPA @Embeddable / @Entity / Spring
        event classes that implement Serializable only to satisfy JPA provider requirements
        (or Spring event infrastructure). They are never directly serialised to byte streams;
        a serialVersionUID would add maintenance burden with no safety benefit.
        Both pattern IDs are suppressed because different SpotBugs versions use different names.
    -->
    <Match>
        <Bug pattern="SE_NO_SERIALVERSIONUID"/>
        <Class name="~com\.cba\..*"/>
    </Match>
    <Match>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
        <Class name="~com\.cba\..*"/>
    </Match>

    <!--
        FraudEngineService catches Exception intentionally (fail-open fraud check).
        When the fraud engine encounters an unexpected error it must not block a legitimate
        transaction — the catch logs the anomaly and returns an APPROVE result with a
        risk flag, so the payment succeeds with monitoring visibility.
    -->
    <Match>
        <Class name="com.cba.fraud.FraudEngineService"/>
        <Bug pattern="REC_CATCH_EXCEPTION,SF_SWITCH_NO_DEFAULT,VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>

    <!--
        PartnerJwtFilter catches Exception at the filter boundary (fail-secure pattern).
        Invalid or tampered tokens produce runtime exceptions from the JOSE library; all
        exceptions are treated as authentication failures (401) rather than server errors.
    -->
    <Match>
        <Class name="com.cba.partner.PartnerJwtFilter"/>
        <Bug pattern="REC_CATCH_EXCEPTION,DE_MIGHT_IGNORE"/>
    </Match>

    <!--
        PartnerJwtService catches Exception when parsing/verifying JWTs. ParseException
        and JOSEException are checked but the JOSE API also throws RuntimeExceptions;
        catching broadly ensures every invalid token produces a clean 401.
    -->
    <Match>
        <Class name="com.cba.partner.PartnerJwtService"/>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>

    <!--
        SecurityPolicyService catches Exception when calling the Keycloak Admin REST API.
        Keycloak may be temporarily unavailable; the service falls back to a default
        policy object so the UI degrades gracefully rather than throwing 500.
    -->
    <Match>
        <Class name="com.cba.system.SecurityPolicyService"/>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>

    <!--
        QrPaymentService catches Exception when processing QR payment events.
        QR payment failures must not propagate as unhandled exceptions into the payment
        pipeline; they are logged and surfaced as payment status FAILED.
    -->
    <Match>
        <Class name="com.cba.wallet.QrPaymentService"/>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>

    <!--
        PartnerService uses SecureRandom once per API key generation call.
        SpotBugs warns that SecureRandom should be reused, but API key generation is
        infrequent (admin-triggered); single-use is acceptable and avoids state sharing.
    -->
    <Match>
        <Class name="com.cba.partner.PartnerService"/>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>

    <!--
        FileSystemStorageProvider constructor validates the upload directory.
        CT_CONSTRUCTOR_THROW is flagged when a constructor throws; this is intentional
        startup validation — an invalid storage directory must prevent application boot.
    -->
    <Match>
        <Class name="com.cba.customer.storage.FileSystemStorageProvider"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!--
        LoanService contains a temporary dead local store from a refactored calculation.
        DLS_DEAD_LOCAL_STORE is low-severity STYLE noise; the variable will be removed
        in the next loan service cleanup pass.
    -->
    <Match>
        <Class name="com.cba.loan.LoanService"/>
        <Bug pattern="DLS_DEAD_LOCAL_STORE"/>
    </Match>

    <!--
        ReportExportService uses default platform encoding in some stream operations.
        The reports are generated as UTF-8 on the JVM default (always UTF-8 in
        Docker/CI environments). DM_DEFAULT_ENCODING is accepted here until a full
        encoding audit pass is done.
    -->
    <Match>
        <Class name="com.cba.report.ReportExportService"/>
        <Bug pattern="DM_DEFAULT_ENCODING"/>
    </Match>

    <!--
        DepositProduct / DepositProductRequest: NM_CONFUSING warns about method names
        that differ only in capitalisation from another type in scope. These follow the
        Mifos domain model naming and are consistent with the rest of the product module.
    -->
    <Match>
        <Class name="com.cba.product.DepositProduct"/>
        <Bug pattern="NM_CONFUSING"/>
    </Match>
    <Match>
        <Class name="com.cba.product.dto.DepositProductRequest"/>
        <Bug pattern="NM_CONFUSING"/>
    </Match>

</FindBugsFilter>
