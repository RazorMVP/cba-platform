<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- DTOs and records have intentional field access patterns -->
    <Match>
        <Class name="~com\.cba\..*\.dto\..*"/>
        <Bug category="STYLE"/>
    </Match>

    <!-- Lombok-generated code -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~com\.cba\..*"/>
    </Match>

    <!-- Spring @Autowired on AttributeConverter is by design -->
    <Match>
        <Class name="com.cba.common.crypto.EncryptedStringConverter"/>
        <Bug pattern="UWF_UNWRITTEN_FIELD"/>
    </Match>

    <!--
        SecurityConfig.devAuthBypassFilter is injected by Spring via @Autowired(required=false).
        It is null in production (the bean doesn't exist without app.auth-bypass=true).
        SpotBugs sees the field as potentially unwritten because it cannot model Spring DI.
    -->
    <Match>
        <Class name="com.cba.config.SecurityConfig"/>
        <Bug pattern="UWF_UNWRITTEN_FIELD"/>
    </Match>

    <!--
        DevAuthBypassFilter.DEV_AUTHORITIES is a private static final List.of() — immutable.
        SpotBugs may flag MS_EXPOSE_REP on static collections even when they are
        unmodifiable. This is dev-only code (ConditionalOnProperty guards it).
    -->
    <Match>
        <Class name="com.cba.config.DevAuthBypassFilter"/>
        <Bug pattern="MS_EXPOSE_REP,MS_SHOULD_BE_FINAL"/>
    </Match>

    <!--
        AuditLogService.toJson() uses string concatenation to build a JSON-escaped fallback.
        SpotBugs may warn about string building patterns; this is intentional defensive code
        for the rare case where Jackson cannot serialize an audit value.
    -->
    <Match>
        <Class name="com.cba.audit.AuditLogService"/>
        <Method name="toJson"/>
        <Bug pattern="DM_STRING_CTOR,SBSC_USE_STRINGBUFFER_CONCATENATION"/>
    </Match>

    <!--
        RateLimitService and RateLimitFilter catch Exception intentionally (fail-open pattern).
        When Redis is unavailable the system must not block legitimate traffic — catching the
        broad Exception from Redis is correct here and the behaviour is documented in comments.
    -->
    <Match>
        <Class name="com.cba.config.RateLimitService"/>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>
    <Match>
        <Class name="com.cba.config.RateLimitFilter"/>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>

    <!--
        ClientImageService deletes the old storage file before replacing it.
        The catch-Exception-ignored pattern on delete is intentional: a failed delete
        of an old file must not abort the save of the new file.
    -->
    <Match>
        <Class name="com.cba.customer.ClientImageService"/>
        <Bug pattern="DE_MIGHT_IGNORE,REC_CATCH_EXCEPTION"/>
    </Match>

    <!--
        NubanSequence has an @EmbeddedId composite key — the class is not directly
        serialised and does not need serialVersionUID.
    -->
    <Match>
        <Class name="com.cba.account.algorithm.NubanSequence"/>
        <Bug pattern="SE_NO_SERIALVERSIONUID"/>
    </Match>
    <Match>
        <Class name="com.cba.account.algorithm.NubanSequenceId"/>
        <Bug pattern="SE_NO_SERIALVERSIONUID"/>
    </Match>

    <!--
        DM_CONVERT_CASE: toLowerCase()/toUpperCase() without explicit Locale.
        All string comparisons in this codebase use ASCII identifiers (enum names,
        currency codes, status strings) — the default locale is irrelevant here.
        Locale.ROOT variants would add noise without correctness benefit.
    -->
    <Match>
        <Bug pattern="DM_CONVERT_CASE"/>
        <Class name="~com\.cba\..*"/>
    </Match>

    <!--
        SE_NO_SERIALVERSIONID: JPA @Embeddable / @Entity classes that implement
        Serializable only to satisfy JPA provider requirements. They are never
        directly serialised to streams; a serialVersionUID would add maintenance
        burden with no safety benefit.
    -->
    <Match>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
        <Class name="~com\.cba\..*"/>
    </Match>

</FindBugsFilter>
