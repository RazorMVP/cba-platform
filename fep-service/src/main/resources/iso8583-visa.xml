<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE isopackager PUBLIC
  "-//jpos.org//DTD ISOPackager//EN"
  "http://jpos.org/dtd/generic-packager-1.0.dtd">

<!--
  Visa ISO 8583-1987 Packager (BASE I / VIS extensions)
  Extends the base packager with Visa private data elements:
  - DE 60: Additional POS Information (Visa-specific terminal and transaction data)
  - DE 61: POS Geographic Data (Visa terminal geographic data)
  - DE 62: Intermediate Network Facility Data (Visa routing and ICA data)
  - DE 63: Network Data (Visa STIP, 3DS/VbV token data)
  - DE 126: Visa-specific network usage data
  All other fields inherit from iso8583-base.xml semantics; identical encoding here.
-->
<isopackager>
  <isofield id="0"   length="4"   name="MTI"                               class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="1"   length="16"   name="Bitmap"                            class="org.jpos.iso.IFB_BITMAP"/>
  <isofield id="2"   length="19"  name="Primary Account Number"            class="org.jpos.iso.IFA_LLNUM"/>
  <isofield id="3"   length="6"   name="Processing Code"                   class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="4"   length="12"  name="Amount Transaction"                class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="5"   length="12"  name="Amount Settlement"                 class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="6"   length="12"  name="Amount Cardholder Billing"         class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="7"   length="10"  name="Transmission Date Time"            class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="8"   length="8"   name="Amount Cardholder Billing Fee"     class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="9"   length="8"   name="Conversion Rate Settlement"        class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="10"  length="8"   name="Conversion Rate Cardholder"        class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="11"  length="6"   name="STAN"                              class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="12"  length="6"   name="Local Transaction Time"            class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="13"  length="4"   name="Local Transaction Date"            class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="14"  length="4"   name="Expiry Date"                       class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="15"  length="4"   name="Settlement Date"                   class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="16"  length="4"   name="Currency Conversion Date"          class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="17"  length="4"   name="Capture Date"                      class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="18"  length="4"   name="MCC"                               class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="19"  length="3"   name="Acquiring Institution Country"     class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="20"  length="3"   name="PAN Extended Country"              class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="21"  length="3"   name="Forwarding Institution Country"    class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="22"  length="3"   name="POS Entry Mode"                    class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="23"  length="3"   name="Card Sequence Number"              class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="24"  length="3"   name="Network International ID"          class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="25"  length="2"   name="POS Condition Code"                class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="26"  length="2"   name="POS PIN Capture Code"              class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="27"  length="1"   name="Auth ID Response Length"           class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="28"  length="9"   name="Amount Transaction Fee"            class="org.jpos.iso.IF_CHAR"/>
  <isofield id="29"  length="9"   name="Amount Settlement Fee"             class="org.jpos.iso.IF_CHAR"/>
  <isofield id="30"  length="9"   name="Amount Transaction Processing Fee" class="org.jpos.iso.IF_CHAR"/>
  <isofield id="31"  length="9"   name="Amount Settlement Processing Fee"  class="org.jpos.iso.IF_CHAR"/>
  <isofield id="32"  length="11"  name="Acquiring Institution ID"          class="org.jpos.iso.IFA_LLNUM"/>
  <isofield id="33"  length="11"  name="Forwarding Institution ID"         class="org.jpos.iso.IFA_LLNUM"/>
  <isofield id="34"  length="28"  name="PAN Extended"                      class="org.jpos.iso.IFA_LLCHAR"/>
  <isofield id="35"  length="37"  name="Track 2 Data"                      class="org.jpos.iso.IFA_LLCHAR"/>
  <isofield id="36"  length="104" name="Track 3 Data"                      class="org.jpos.iso.IFA_LLLCHAR"/>
  <isofield id="37"  length="12"  name="Retrieval Reference Number"        class="org.jpos.iso.IF_CHAR"/>
  <isofield id="38"  length="6"   name="Authorization ID Response"         class="org.jpos.iso.IF_CHAR"/>
  <isofield id="39"  length="2"   name="Response Code"                     class="org.jpos.iso.IF_CHAR"/>
  <isofield id="40"  length="3"   name="Service Restriction Code"          class="org.jpos.iso.IF_CHAR"/>
  <isofield id="41"  length="8"   name="Card Acceptor Terminal ID"         class="org.jpos.iso.IF_CHAR"/>
  <isofield id="42"  length="15"  name="Card Acceptor ID Code"             class="org.jpos.iso.IF_CHAR"/>
  <isofield id="43"  length="40"  name="Card Acceptor Name Location"       class="org.jpos.iso.IF_CHAR"/>
  <isofield id="44"  length="25"  name="Additional Response Data"          class="org.jpos.iso.IFA_LLCHAR"/>
  <isofield id="45"  length="76"  name="Track 1 Data"                      class="org.jpos.iso.IFA_LLCHAR"/>
  <isofield id="46"  length="999" name="Additional Data ISO"               class="org.jpos.iso.IFA_LLLCHAR"/>
  <isofield id="47"  length="999" name="Additional Data National"          class="org.jpos.iso.IFA_LLLCHAR"/>
  <isofield id="48"  length="999" name="Additional Data Private"           class="org.jpos.iso.IFA_LLLCHAR"/>
  <isofield id="49"  length="3"   name="Currency Code Transaction"         class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="50"  length="3"   name="Currency Code Settlement"          class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="51"  length="3"   name="Currency Code Cardholder Billing"  class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="52"  length="8"   name="PIN Data"                          class="org.jpos.iso.IFB_BINARY"/>
  <isofield id="53"  length="16"  name="Security Related Control Info"     class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="54"  length="120" name="Additional Amounts"                class="org.jpos.iso.IFA_LLLCHAR"/>
  <isofield id="55"  length="999" name="ICC Data EMV"                      class="org.jpos.iso.IFB_LLLBINARY"/>
  <isofield id="56"  length="999" name="Reserved ISO 1"                    class="org.jpos.iso.IFA_LLLCHAR"/>
  <isofield id="57"  length="999" name="Reserved National 1"               class="org.jpos.iso.IFA_LLLCHAR"/>
  <isofield id="58"  length="999" name="Reserved National 2"               class="org.jpos.iso.IFA_LLLCHAR"/>
  <isofield id="59"  length="999" name="Reserved National 3"               class="org.jpos.iso.IFA_LLLCHAR"/>

  <!-- Visa Private DE 60: Additional POS Information -->
  <!-- Format: LL + data; contains terminal type, PIN capability, category codes -->
  <isofield id="60"  length="999" name="Visa Additional POS Information"   class="org.jpos.iso.IFA_LLLCHAR"/>

  <!-- Visa Private DE 61: POS Geographic Data -->
  <!-- Format: LL + data; acquirer timezone, terminal geographic indicator -->
  <isofield id="61"  length="999" name="Visa POS Geographic Data"          class="org.jpos.iso.IFA_LLLCHAR"/>

  <!-- Visa Private DE 62: Intermediate Network Facility Data -->
  <!-- Format: LL + data; ICA, BIC, routing flags -->
  <isofield id="62"  length="999" name="Visa INF Data"                     class="org.jpos.iso.IFA_LLLCHAR"/>

  <!-- Visa Private DE 63: Network Data -->
  <!-- Format: LL + data; STIP indicators, VbV/3DS CAVV, token data -->
  <isofield id="63"  length="999" name="Visa Network Data"                 class="org.jpos.iso.IFA_LLLCHAR"/>

  <isofield id="64"  length="8"   name="MAC Primary"                       class="org.jpos.iso.IFB_BINARY"/>
  <isofield id="65"  length="8"   name="Bitmap Tertiary"                   class="org.jpos.iso.IFB_BITMAP"/>
  <isofield id="66"  length="1"   name="Settlement Code"                   class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="67"  length="2"   name="Extended Payment Code"             class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="68"  length="3"   name="Receiving Institution Country"     class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="69"  length="3"   name="Settlement Institution Country"    class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="70"  length="3"   name="Network Management Info Code"      class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="90"  length="42"  name="Original Data Elements"            class="org.jpos.iso.IFA_NUMERIC"/>
  <isofield id="95"  length="42"  name="Replacement Amounts"               class="org.jpos.iso.IF_CHAR"/>
  <isofield id="96"  length="8"   name="Message Security Code"             class="org.jpos.iso.IFB_BINARY"/>
  <isofield id="100" length="11"  name="Receiving Institution ID"          class="org.jpos.iso.IFA_LLNUM"/>
  <isofield id="102" length="28"  name="Account ID 1"                      class="org.jpos.iso.IFA_LLCHAR"/>
  <isofield id="103" length="28"  name="Account ID 2"                      class="org.jpos.iso.IFA_LLCHAR"/>

  <!-- Visa Private DE 126: Visa Network Usage Data -->
  <!-- Contains settlement flags, reimbursement attribute, ICA number -->
  <isofield id="126" length="999" name="Visa Network Usage Data"           class="org.jpos.iso.IFA_LLLCHAR"/>

  <isofield id="128" length="8"   name="MAC Secondary"                     class="org.jpos.iso.IFB_BINARY"/>
</isopackager>
