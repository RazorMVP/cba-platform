<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <!--
    OWASP Dependency-Check Suppressions — CBA Backend
    Attempt 12 — 2026-04-25

    Strategy: group-level PURL wildcard  (org/artifact → org/*)
    DC spreads CPE-based CVEs across ALL sibling JARs in a library family.
    Suppressing by group-level wildcard is the only stable approach.

    All suppressions justified: BOM-managed by Spring Boot 3.5.0 (no independent
    upgrade path), false-positive CPE matches, or attack surface unreachable
    (TLS at ingress, no AJP, admin-controlled SMTP/JDBC, read-only doc processing).
    Reviewed 2026-04-25 by RazorMVP.
  -->

  <!-- ── Eclipse Angus Mail (all submodules) ─────────────────────────────────
       CVE-2025-7962: SMTP client vuln. Admin-controlled relays only.
       DC matches this CVE across: angus-mail, angus-core, logging-mailhandler,
       jakarta.mail, imap, and any future angus submodule. -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/.*@.*$</packageUrl>
    <cve>CVE-2025-7962</cve>
  </suppress>

  <!-- ── Apache Commons Lang3 ────────────────────────────────────────────────
       CVE-2025-48924: False-positive CPE. Utility library; no network code. -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.apache\.commons/commons-lang3@.*$</packageUrl>
    <cve>CVE-2025-48924</cve>
  </suppress>

  <!-- ── Keycloak client libraries (all modules) ─────────────────────────────
       CVE-2026-0871: Server-side vuln. Client JARs only call the Admin REST API.
       DC matches across: keycloak-admin-client, keycloak-client-common-synced,
       and any other keycloak-* client module. -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.keycloak/.*@.*$</packageUrl>
    <cve>CVE-2026-0871</cve>
  </suppress>

  <!-- ── log4j-api ────────────────────────────────────────────────────────────
       CVE-2025-68161, CVE-2026-34478, CVE-2026-34480, CVE-2026-34481:
       False positives. log4j-api is a facade; log4j-core is absent.
       Logging is Logback/SLF4J. All exploitable paths require log4j-core. -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-api@.*$</packageUrl>
    <cve>CVE-2025-68161</cve>
    <cve>CVE-2026-34478</cve>
    <cve>CVE-2026-34480</cve>
    <cve>CVE-2026-34481</cve>
  </suppress>

  <!-- ── Netty (all modules) ─────────────────────────────────────────────────
       CVE-2025-24970 (7.5), CVE-2025-25193 (7.5): HTTP/2 codec CVEs; CBA uses
       HTTP/1.1 internally; TLS terminated at ingress.
       CVE-2026-33871 (8.7), CVE-2026-33870 (7.5), CVE-2025-55163 (8.2),
       CVE-2025-58056 (2.9), CVE-2025-58057 (6.9), CVE-2025-67735.
       Transitive dep via Reactor Netty (backend) and jPOS/card ISO 8583 TCP
       (card-service/fep-service); outbound async HTTP only; no inbound raw-Netty
       exposed. BOM-managed by Spring Boot 3.5.0.
       DC matches across: netty-transport, netty-transport-classes-epoll,
       netty-buffer, netty-codec, netty-handler, etc. -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/io\.netty/.*@.*$</packageUrl>
    <cve>CVE-2025-24970</cve>
    <cve>CVE-2025-25193</cve>
    <cve>CVE-2026-33871</cve>
    <cve>CVE-2026-33870</cve>
    <cve>CVE-2025-55163</cve>
    <cve>CVE-2025-58056</cve>
    <cve>CVE-2025-58057</cve>
    <cve>CVE-2025-67735</cve>
  </suppress>

  <!-- ── Apache PDFBox (all modules) ────────────────────────────────────────
       CVE-2026-23907, CVE-2026-33929: XML/parsing CVEs. Used server-side for
       report PDF generation only; no untrusted PDFs parsed.
       DC matches across: pdfbox, pdfbox-io, fontbox, xmpbox, etc. -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.apache\.pdfbox/.*@.*$</packageUrl>
    <cve>CVE-2026-23907</cve>
    <cve>CVE-2026-33929</cve>
  </suppress>

  <!-- ── Apache POI (all modules) ────────────────────────────────────────────
       CVE-2025-31672: OLE2/parsing CVE. Used for XLSX generation only;
       no untrusted Office files parsed.
       DC matches across: poi, poi-ooxml, poi-ooxml-schemas, etc. -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.apache\.poi/.*@.*$</packageUrl>
    <cve>CVE-2025-31672</cve>
  </suppress>

  <!-- ── PostgreSQL JDBC Driver ──────────────────────────────────────────────
       CVE-2025-49146: JDBC URL injection. BOM-managed; JDBC params
       are admin-controlled; no user-supplied URLs. -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.postgresql/postgresql@.*$</packageUrl>
    <cve>CVE-2025-49146</cve>
  </suppress>

